---
const steps = [
  {
    title: "1. Pick games you love",
    text: "Search the library and add the games you have already played.",
  },
  {
    title: "2. We build your taste profile",
    text: "Each game is turned into a vector from its description, genres and tags. Your profile is the average of the games you picked.",
  },
  {
    title: "3. Similar games are ranked",
    text: "Candidates are found with vector search, then re-ranked by shared tags and rating, so good games rise to the top.",
  },
  {
    title: "4. You see why",
    text: "Every result shows the game you played that it is most similar to, plus a match score.",
  },
];
---

<section id="how-it-works" class="py-12 border-t border-[#ffffff10] text-[var(--white)] scroll-mt-24">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Under the hood</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">How it works</h3>
    <ol class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {
        steps.map((step) => (
          <li class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-5">
            <h4 class="mb-2 text-lg font-semibold">{step.title}</h4>
            <p class="text-[var(--white-icon)]">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
